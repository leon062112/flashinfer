+@flashinfer_api
+def sglang_style_cascade_attention(
+    q: torch.Tensor,
+    k_current: torch.Tensor,
+    v_current: torch.Tensor,
+    qo_indptr: torch.Tensor,
+    kv_curr_indptr: torch.Tensor,
